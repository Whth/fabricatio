    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "pinia": "3.0.4",
    "vue": "3.5.38",
    "vue-i18n": "^11.4.10",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/eslint-plugin": "1.6.20",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
