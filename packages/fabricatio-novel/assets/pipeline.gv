// fabricatio-novel: staged pipeline with its LLM call inventory.
// Render: dot -Tsvg pipeline.gv -o pipeline.svg
// Templates are .hbs files under templates/built-in/ (full mapping in the README table).
digraph pipeline {
    rankdir=TB;
    bgcolor="white";
    fontname="serif";
    pad="0.45";
    nodesep=0.45;
    ranksep=0.42;
    labelloc="b";
    label="  a stage naming a template makes those batched LLM calls; gray = pure code";

    node [shape=box, style="filled", fillcolor="white", color="black",
          fontname="serif", fontsize=13, margin="0.18,0.10"];
    edge [color="black", arrowsize=0.75, fontname="serif", fontsize=11];

    // left column — novel scope
    outline [label="outline\l(+ optional bible, constraint,\lRAG query)\l", shape=note, fillcolor="#F2F2F2"];
    initmeta [label="01–02 Init & metadata\lnovel_metadata_requirement\l⇒ NovelPlan (title, word count,\lwriting constraints, bible)\loptional RAG: seals the root,\lfetches refs from the outline\l"];
    bible    [label="03 Bible\lsetting_bible_*\l⇒ SeriesBible (characters +\lbackground settings), seeded\l(skipped when one is given)\l"];
    chars    [label="04 Roster spans\lnovel_character_span\l⇒ CharacterSpan[] per character\l(skipped without a roster)\l"];
    chapters [label="05 Chapters\lchapter_plan ⇒ ChapterPlan[]\lchapter_character_span ⇒ N−1\lboundary cards, stitched in code\loptional RAG: renders the novel's refs\l"];

    // right column — chapter scope
    stories [label="06 Stories\lstory_plan ⇒ StoryPlan[]\lstory_character_span ⇒ S−1\lboundary cards, stitched in code\loptional RAG: seals rag (query, limit)\l"];
    splan   [label="07 Scene plans\lscene_plan ⇒ ScenePlan[]\loptional RAG: fetch + merge style refs\l"];
    prose   [label="08 Scene prose\lscene_requirement ⇒ plain prose\lthe only content-writing call\l(serial per scene)\l"];
    asm     [label="09 Assemble & export\lNovel.from_context\l⇒ EPUB / chapters/NN.txt\l", fillcolor="#E8E8E8"];

    outline  -> initmeta;
    initmeta -> bible;
    bible    -> chars;
    chars    -> chapters;
    chapters -> stories [label=" per chapter ×C", constraint=false];
    stories  -> splan;
    splan    -> prose [label=" per story ×S"];
    prose    -> asm;

    { rank=same; outline;  stories; }
    { rank=same; initmeta; splan;   }
    { rank=same; bible;    prose;   }
    { rank=same; chars;    asm;     }
    { rank=same; chapters; }
}
