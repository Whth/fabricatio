// fabricatio-novel: how one scene write prompt is assembled, and what comes back.
// Render: dot -Tsvg prompt-assembly.gv -o prompt-assembly.svg
digraph assembly {
    rankdir=LR;
    bgcolor="white";
    fontname="serif";
    pad="0.45";
    nodesep=0.26;
    ranksep=0.55;

    node [shape=box, style="filled", fillcolor="white", color="black",
          fontname="serif", fontsize=13, margin="0.14,0.07"];
    edge [color="black", arrowsize=0.7, fontname="serif", fontsize=11];

    subgraph cluster_sources {
        label="context channel (SceneContext)";
        labelloc="t";
        labeljust="l";
        fontname="serif";
        fontsize=12;
        color="#808080";
        style="rounded";

        src_prefix [label="prefix_log.render()\lrunning manuscript prefix:\lheadings, prior chapters,\lstories, scenes, seeded bible\l"];
        src_styles [label="dump_writing_styles()\lstyle directives\l(+ retrieved RAG refs)\l"];
        src_sofar  [label="scenes_log.render()\lprior scenes of this story;\lgrows after every scene —\leach result becomes\lthe next “so far”\l"];
        src_scene  [label="plan fields — the only tail\ltitle · description · count\lscene style · constraint\l"];
        src_chars  [label="dump_characters()\lstart/end state cards\lper character\l"];
        src_misc   [label="cast (comma list) · language\l"];
    }

    prompt [shape=plaintext, style="", fillcolor="white",
            label=<
                <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="white">
                    <tr><td align="left"><b># Scene Writing</b> — static head</td></tr>
                    <tr><td align="left"># Previous Content — prefix log</td></tr>
                    <tr><td align="left">## Writing Styles — directives</td></tr>
                    <tr><td align="left">## Story so far — prior scenes</td></tr>
                    <tr><td align="left" bgcolor="#E8E8E8">## Scene — title, words, style</td></tr>
                    <tr><td align="left" bgcolor="#E8E8E8">## Writing Constraint</td></tr>
                    <tr><td align="left" bgcolor="#E8E8E8">## Characters' state arc</td></tr>
                    <tr><td align="left" bgcolor="#E8E8E8">## Cast</td></tr>
                </table>
            >];

    write [label="one LLM call per scene\l⇒ plain prose (no JSON)\lScene.content via set_content\l"];

    // keep the outcome box directly below the prompt, not to its right
    { rank=same; prompt; write; }

    src_prefix -> prompt;
    src_styles -> prompt;
    src_sofar  -> prompt;
    src_scene  -> prompt;
    src_chars  -> prompt;
    src_misc   -> prompt;

    prompt -> write [constraint=false];

    labelloc="b";
    label="  gray rows = per-scene tail; white rows are byte-identical across a story's scenes,\l  so repeated prefixes hit the provider cache";
}
